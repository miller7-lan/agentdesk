{
  "name": "agentdesk-ui",
  "productName": "AgentDesk",
  "version": "0.2.7",
  "description": "AI 编程助手桌面端：连接 VPS 上的 Codex 操作 Windows 开发机",
  "main": "main.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "prepare:desktop": "node scripts/prepare-desktop.js",
    "prestart": "npm run prepare:desktop",
    "start": "electron .",
    "predist": "npm run prepare:desktop -- --win",
    "dist": "electron-builder --win portable nsis --x64",
    "predist:mac": "npm run prepare:desktop -- --mac",
    "dist:mac": "electron-builder --mac dir",
    "predist:mac:release": "npm run prepare:desktop -- --mac",
    "dist:mac:release": "electron-builder --mac dmg zip"
  },
  "build": {
    "appId": "local.agentdesk.ui",
    "productName": "AgentDesk",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "app-config.js",
      "onboarding.js",
      "logger.js",
      "diagnostics.js",
      "preload.js",
      "clawd.js",
      "remote.js",
      "chat-link.js",
      "local-files.js",
      "local-commands.js",
      "workspace.js",
      "build/icon.png",
      "src/**/*",
      "desktop.js",
      "windows-files.js",
      "local-change.js",
      "orchestrator/*.js",
      "updates.js"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ]
      }
    },
    "portable": {
      "artifactName": "AgentDesk-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "AgentDesk-${version}-setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "desktop-backend",
        "to": "desktop-backend"
      },
      {
        "from": ".",
        "filter": [
          "agentdesk-enrollment.json",
          "agentdesk-server.json"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": "dir",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "AgentDesk 使用本机桌面工具协助你操作已授权的应用。"
      },
      "hardenedRuntime": true,
      "notarize": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "afterSign": "build/notarize.js"
  },
  "devDependencies": {
    "@electron/notarize": "3.1.2",
    "agent-desktop": "1.3.1",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
