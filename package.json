{
  "name": "agentdesk-ui",
  "productName": "AgentDesk",
  "version": "0.4.10",
  "description": "AI 编程助手桌面端：连接 VPS 上的 Codex 操作 Windows 开发机",
  "main": "main.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "prepare:desktop": "node scripts/fix-node-pty.js && node scripts/prepare-desktop.js",
    "prestart": "npm run prepare:desktop",
    "start": "electron .",
    "predist": "npm run prepare:desktop -- --win",
    "dist": "electron-builder --win portable nsis --x64",
    "predist:mac": "npm run prepare:desktop -- --mac",
    "dist:mac": "electron-builder --mac dir",
    "predist:mac:release": "npm run prepare:desktop -- --mac",
    "dist:mac:release": "electron-builder --mac dmg zip",
    "postinstall": "node scripts/fix-node-pty.js",
    "dist:bundle": "electron-builder --win portable nsis --x64 --config build/bundle-connection.config.js",
    "predist:bundle": "npm run prepare:desktop -- --win"
  },
  "build": {
    "appId": "local.agentdesk.ui",
    "productName": "AgentDesk",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "http://127.0.0.1/agentdesk-client-updates/"
      }
    ],
    "files": [
      "main.js",
      "app-config.js",
      "bridge-root.js",
      "onboarding.js",
      "logger.js",
      "diagnostics.js",
      "preload.js",
      "clawd.js",
      "remote.js",
      "chat-link.js",
      "local-files.js",
      "local-commands.js",
      "attachment-files.js",
      "checkpoints.js",
      "session-worktrees.js",
      "project-deletion.js",
      "workspace.js",
      "build/icon.png",
      "src/**/*",
      "desktop.js",
      "windows-files.js",
      "local-change.js",
      "orchestrator/*.js",
      "updates.js",
      "mac-manual-updater.js",
      "device-identity.js",
      "update-transport.js",
      "update-gate.js",
      "connection-config.js",
      "build-info.json",
      "CHANGELOG.md",
      "scripts/changelog-notes.js"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ]
      }
    },
    "portable": {
      "artifactName": "AgentDesk-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "AgentDesk-${version}-setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "extraResources": [
      {
        "from": "desktop-backend",
        "to": "desktop-backend"
      },
      {
        "from": "orchestrator/ssh-jump.js",
        "to": "ssh-jump.js"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": "dir",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "AgentDesk 使用本机桌面工具协助你操作已授权的应用。"
      },
      "hardenedRuntime": true,
      "notarize": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "afterSign": "build/notarize.js",
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/node-pty/**"
    ]
  },
  "devDependencies": {
    "@electron/notarize": "3.1.2",
    "agent-desktop": "1.3.1",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "@xterm/xterm": "6.0.0",
    "@xterm/addon-fit": "0.11.0"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "node-pty": "1.1.0"
  }
}
