{
  "name": "agentdesk-ui",
  "productName": "AgentDesk",
  "version": "0.2.7",
  "description": "AI 编程助手桌面端：连接 VPS 上的 Codex 操作 Windows 开发机",
  "main": "main.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "prepare:desktop": "node scripts/prepare-desktop.js",
    "prestart": "npm run prepare:desktop",
    "start": "electron .",
    "predist": "npm run prepare:desktop -- --win",
    "dist": "electron-builder --win portable nsis",
    "predist:mac": "npm run prepare:desktop -- --mac",
    "dist:mac": "electron-builder --mac dir"
  },
  "build": {
    "appId": "local.agentdesk.ui",
    "productName": "AgentDesk",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "clawd.js",
      "remote.js",
      "workspace.js",
      "build/icon.png",
      "src/**/*",
      "desktop.js",
      "windows-files.js",
      "logger.js",
      "orchestrator/*.js"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "portable": {
      "artifactName": "AgentDesk-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "AgentDesk-${version}-setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "desktop-backend",
        "to": "desktop-backend"
      },
      {
        "from": ".",
        "filter": [
          "agentdesk-enrollment.json"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "target": "dir",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "AgentDesk 使用本机桌面工具协助你操作已授权的应用。"
      }
    }
  },
  "devDependencies": {
    "agent-desktop": "1.3.1",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0"
  }
}
