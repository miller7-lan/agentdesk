# Validate with sshd -t before reloading OpenSSH.
Match User agentdesk
    PubkeyAuthentication yes
    AuthenticationMethods publickey
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    AuthorizedKeysFile /etc/ssh/agentdesk-authorized-keys
    DisableForwarding yes
    PermitTTY no
    PermitUserRC no
Match all
