{
  "stateDir": "/var/lib/agentdesk-orchestrator",
  "retention": {
    "completedDays": 3,
    "failedDays": 7,
    "historyDays": 60,
    "uploadDays": 7,
    "minFreePercent": 15
  },
  "cliTimeoutMs": 900000,
  "discoverModels": true,
  "taskBudget": {
    "steps": 24,
    "tokens": 3000000
  },
  "quotaBridges": [],
  "maxConcurrentTasks": 2,
  "writeProviders": [
    "codex",
    "claude",
    "grok",
    "antigravity"
  ],
  "adapters": {
    "codex": {
      "bin": "/usr/local/bin/codex",
      "models": {
        "gpt-5.4": {
          "strengths": "Complex coding, multi-file changes, and debugging.",
          "billing": "subscription"
        }
      }
    },
    "claude": {
      "bin": "/usr/local/bin/claude",
      "defaultModel": "claude-opus-5-5",
      "models": {
        "claude-opus-5-5": {
          "label": "Opus 5.5",
          "strengths": "Complex implementation and deep analysis.",
          "billing": "subscription",
          "efforts": ["low", "medium", "high", "xhigh", "max"],
          "defaultEffort": "high"
        },
        "claude-sonnet-5-5": {
          "label": "Sonnet 5.5",
          "strengths": "General coding and code review.",
          "billing": "subscription",
          "efforts": ["low", "medium", "high", "xhigh", "max"],
          "defaultEffort": "medium"
        },
        "claude-haiku-5-5": {
          "label": "Haiku 5.5",
          "strengths": "Fast questions and concise summaries.",
          "billing": "subscription",
          "efforts": ["low", "medium", "high"],
          "defaultEffort": "low"
        },
        "claude-fable-5-1": {
          "label": "Fable 5.1",
          "strengths": "Frontier coding and long multi-step exploration.",
          "billing": "subscription",
          "efforts": ["low", "medium", "high", "xhigh", "max"],
          "defaultEffort": "high"
        }
      },
      "sandbox": true
    },
    "grok": {
      "bin": "/usr/local/bin/grok",
      "defaultModel": "grok-4.7",
      "models": {
        "grok-4.7": {
          "label": "Grok 4.7",
          "strengths": "Coding and tool use.",
          "billing": "subscription",
          "efforts": ["low", "medium", "high", "xhigh"],
          "defaultEffort": "high"
        },
        "grok-4.7-build-fast": {
          "label": "Grok 4.7 Build Fast",
          "strengths": "Faster coding on eligible plans.",
          "billing": "subscription",
          "efforts": ["low", "medium", "high", "xhigh"],
          "defaultEffort": "medium"
        },
        "grok-4.6": {
          "label": "Grok 4.6",
          "strengths": "Coding and investigation.",
          "billing": "subscription",
          "efforts": ["low", "medium", "high", "xhigh"],
          "defaultEffort": "high"
        },
        "grok-4.5": {
          "label": "Grok 4.5",
          "strengths": "General analysis.",
          "billing": "subscription",
          "efforts": ["low", "medium", "high", "xhigh"],
          "defaultEffort": "medium"
        }
      },
      "callLimits": {
        "fiveHour": 60,
        "weekly": 600
      },
      "sandbox": true
    },
    "antigravity": {
      "bin": "/usr/local/bin/agy",
      "models": {
        "gemini-3.8-flash-low": {
          "label": "Gemini 3.8 Flash (Low)",
          "strengths": "Fastest, plenty of quota. Default for listing files, short searches, routine reading and quick summaries.",
          "billing": "subscription"
        },
        "gemini-3.8-flash-medium": {
          "label": "Gemini 3.8 Flash (Medium)",
          "strengths": "Fast with plenty of quota. Default for scouting, research with Google search, routine single-file edits and first-pass review.",
          "billing": "subscription"
        },
        "gemini-3.8-flash-high": {
          "label": "Gemini 3.8 Flash (High)",
          "strengths": "Deeper reasoning, slower. Multi-file implementation, hard debugging, architecture questions and security-sensitive review; use sparingly.",
          "billing": "subscription"
        }
      },
      "template": {
        "prompt": "arg",
        "output": "jsonl",
        "session": "field",
        "args": [
          "--output-format",
          "stream-json",
          "--print-timeout",
          "10m",
          "-p",
          "{prompt}"
        ],
        "readonlyArgs": [
          "--mode",
          "plan"
        ],
        "writeArgs": [
          "--mode",
          "accept-edits"
        ],
        "modelArgs": [
          "--model",
          "{model}"
        ],
        "resumeArgs": [
          "--conversation",
          "{session}"
        ],
        "outputField": "result.response",
        "sessionField": "result.conversation_id",
        "usageField": "result.usage",
        "errorField": "result.error"
      },
      "defaultModel": "gemini-3.8-flash-medium",
      "callLimits": {
        "fiveHour": 300,
        "weekly": 3000
      },
      "sandbox": true
    }
  },
  "routing": {
    "plan": [
      "claude",
      "codex"
    ],
    "triage": [
      "claude"
    ],
    "scout": [
      "antigravity",
      "grok"
    ],
    "implement": [
      "antigravity",
      "codex",
      "grok"
    ],
    "review": [
      "antigravity",
      "grok"
    ],
    "research": [
      "antigravity",
      "grok"
    ],
    "accept": [
      "claude"
    ]
  },
  "quotaPolicy": {
    "claude": {
      "soft": 60,
      "hard": 95,
      "keepFor": [
        "plan",
        "triage",
        "accept"
      ]
    },
    "codex": {
      "soft": 70,
      "hard": 95,
      "keepFor": [
        "implement"
      ]
    }
  },
  "ownerCaps": {
    "default": {
      "claude": 20,
      "codex": 30,
      "grok": 40,
      "gemini": 40,
      "antigravity": 40
    },
    "mac": {
      "claude": 15
    }
  },
  "projects": {
    "agentdesk": {
      "members": [
        "mac"
      ],
      "workspaces": {
        "mac": "mac"
      }
    }
  },
  "workspaces": {
    "project": {
      "repository": "/var/lib/agentdesk-orchestrator/repos/project.git"
    },
    "mac": {
      "repository": "/var/lib/agentdesk-orchestrator/repos/mac.git",
      "sshBridge": "mac"
    }
  },
  "relay": {
    "host": "relay.example.invalid",
    "port": 22022,
    "deviceId": "vps2-orchestrator",
    "tokenFile": "/etc/agentdesk-orchestrator/relay.token",
    "caFile": "/etc/agentdesk-orchestrator/relay-ca.pem"
  },
  "sshBridges": [
    "mac"
  ],
  "relayBridges": {
    "mac": {
      "host": "relay.example.invalid",
      "port": 22022,
      "deviceId": "vps2-orchestrator-mac",
      "tokenFile": "/etc/agentdesk-orchestrator/relay-mac.token",
      "caFile": "/etc/agentdesk-orchestrator/relay-ca.pem"
    }
  }
}
