{
  "stateDir": "/var/lib/agentdesk-orchestrator",
  "cliTimeoutMs": 900000,
  "quotaBridges": [],
  "maxConcurrentTasks": 2,
  "writeProviders": [
    "codex",
    "claude",
    "grok",
    "antigravity"
  ],
  "adapters": {
    "codex": {
      "bin": "/usr/local/bin/codex",
      "models": {
        "gpt-5.4": {
          "strengths": "Complex coding, multi-file changes, and debugging.",
          "billing": "subscription"
        }
      }
    },
    "claude": {
      "bin": "/usr/local/bin/claude",
      "models": {
        "claude-sonnet-5-5": {
          "strengths": "Balanced code review, reasoning, and synthesis.",
          "billing": "subscription"
        }
      }
    },
    "grok": {
      "bin": "/usr/local/bin/grok",
      "models": {
        "grok-build-0.1": {
          "strengths": "Quick code investigation and web development research.",
          "billing": "subscription"
        }
      },
      "callLimits": {
        "fiveHour": 60,
        "weekly": 600
      }
    },
    "antigravity": {
      "bin": "/usr/local/bin/agy",
      "models": {
        "gemini-4-hydrogen": {
          "strengths": "Fast with plenty of quota. Default for scouting, research with Google search, routine single-file edits and first-pass review.",
          "billing": "subscription"
        },
        "gemini-4-argon": {
          "strengths": "Frontier coding agent for multi-file implementation and long multi-step tasks. Use for implement steps beyond a small edit.",
          "billing": "subscription"
        },
        "gemini-4-carbon": {
          "strengths": "Deepest reasoning (Ultra only), slower. Hard debugging, architecture questions and security-sensitive review; use sparingly.",
          "billing": "subscription"
        }
      },
      "template": {
        "prompt": "arg",
        "output": "jsonl",
        "session": "field",
        "args": [
          "--output-format",
          "stream-json",
          "--print-timeout",
          "10m",
          "-p",
          "{prompt}"
        ],
        "readonlyArgs": [
          "--mode",
          "plan"
        ],
        "writeArgs": [
          "--mode",
          "accept-edits"
        ],
        "modelArgs": [
          "--model",
          "{model}"
        ],
        "resumeArgs": [
          "--conversation",
          "{session}"
        ],
        "outputField": "result.response",
        "sessionField": "result.conversation_id",
        "usageField": "result.usage",
        "errorField": "result.error"
      },
      "defaultModel": "gemini-4-hydrogen",
      "callLimits": {
        "fiveHour": 300,
        "weekly": 3000
      }
    }
  },
  "routing": {
    "plan": [
      "claude",
      "codex"
    ],
    "triage": [
      "claude"
    ],
    "scout": [
      "antigravity",
      "grok"
    ],
    "implement": [
      "antigravity",
      "codex",
      "grok"
    ],
    "review": [
      "antigravity",
      "grok"
    ],
    "research": [
      "antigravity",
      "grok"
    ],
    "accept": [
      "claude"
    ]
  },
  "quotaPolicy": {
    "claude": {
      "soft": 60,
      "hard": 95,
      "keepFor": [
        "plan",
        "triage",
        "accept"
      ]
    },
    "codex": {
      "soft": 70,
      "hard": 95,
      "keepFor": [
        "implement"
      ]
    }
  },
  "ownerCaps": {
    "default": {
      "claude": 20,
      "codex": 30,
      "grok": 40,
      "gemini": 40,
      "antigravity": 40
    },
    "mac": {
      "claude": 15
    }
  },
  "projects": {
    "agentdesk": {
      "members": [
        "mac"
      ],
      "workspaces": {
        "mac": "mac"
      }
    }
  },
  "workspaces": {
    "project": {
      "repository": "/var/lib/agentdesk-orchestrator/repos/project.git"
    },
    "mac": {
      "repository": "/var/lib/agentdesk-orchestrator/repos/mac.git",
      "sshBridge": "mac"
    }
  },
  "relay": {
    "host": "relay.example.invalid",
    "port": 22022,
    "deviceId": "vps2-orchestrator",
    "tokenFile": "/etc/agentdesk-orchestrator/relay.token",
    "caFile": "/etc/agentdesk-orchestrator/relay-ca.pem"
  },
  "sshBridges": [
    "mac"
  ],
  "relayBridges": {
    "mac": {
      "host": "relay.example.invalid",
      "port": 22022,
      "deviceId": "vps2-orchestrator-mac",
      "tokenFile": "/etc/agentdesk-orchestrator/relay-mac.token",
      "caFile": "/etc/agentdesk-orchestrator/relay-ca.pem"
    }
  }
}
