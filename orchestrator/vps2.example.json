{
  "stateDir": "/var/lib/agentdesk-orchestrator",
  "cliTimeoutMs": 900000,
  "quotaBridges": [],
  "adapters": {
    "codex": {
      "bin": "/usr/local/bin/codex",
      "models": {
        "gpt-5.4": {
          "strengths": "Complex coding, multi-file changes, and debugging.",
          "billing": "api",
          "inputUsdPerMillion": 2.5,
          "outputUsdPerMillion": 15
        }
      },
      "credentials": {
        "OPENAI_API_KEY": "/etc/agentdesk-orchestrator/openai.key"
      }
    },
    "claude": {
      "bin": "/usr/local/bin/claude",
      "models": {
        "claude-sonnet-5-5": {
          "strengths": "Balanced code review, reasoning, and synthesis.",
          "billing": "api",
          "inputUsdPerMillion": 2,
          "outputUsdPerMillion": 10
        }
      },
      "credentials": {
        "ANTHROPIC_API_KEY": "/etc/agentdesk-orchestrator/anthropic.key"
      }
    },
    "grok": {
      "bin": "/usr/local/bin/grok",
      "models": {
        "grok-build-0.1": {
          "strengths": "Quick code investigation and web development research.",
          "billing": "api",
          "inputUsdPerMillion": 1,
          "outputUsdPerMillion": 2
        }
      },
      "credentials": {
        "XAI_API_KEY": "/etc/agentdesk-orchestrator/xai.key"
      }
    },
    "gemini": {
      "bin": "/usr/local/bin/gemini",
      "models": {
        "gemini-2.5-flash-lite": {
          "strengths": "Low-cost classification, extraction, and summarization.",
          "billing": "api",
          "inputUsdPerMillion": 0.1,
          "outputUsdPerMillion": 0.4
        }
      },
      "credentials": {
        "GEMINI_API_KEY": "/etc/agentdesk-orchestrator/gemini.key"
      }
    }
  },
  "workspaces": {
    "project": {
      "repository": "/var/lib/agentdesk-orchestrator/repos/project.git"
    },
    "mac": {
      "repository": "/var/lib/agentdesk-orchestrator/repos/mac.git",
      "sshBridge": "mac"
    }
  },
  "relay": {
    "host": "relay.example.invalid",
    "port": 22022,
    "deviceId": "vps2-orchestrator",
    "tokenFile": "/etc/agentdesk-orchestrator/relay.token",
    "caFile": "/etc/agentdesk-orchestrator/relay-ca.pem"
  },
  "sshBridges": [
    "mac"
  ],
  "relayBridges": {
    "mac": {
      "host": "relay.example.invalid",
      "port": 22022,
      "deviceId": "vps2-orchestrator-mac",
      "tokenFile": "/etc/agentdesk-orchestrator/relay-mac.token",
      "caFile": "/etc/agentdesk-orchestrator/relay-ca.pem"
    }
  }
}
