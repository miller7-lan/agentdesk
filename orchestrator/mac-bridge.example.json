{
  "stateDir": "/Users/yourname/Library/Application Support/AgentDesk/bridge/state",
  "controlSocket": "/Users/yourname/Library/Application Support/AgentDesk/bridge/state/control.sock",
  "controlWorkspace": "mac",
  "readAnyFolder": true,
  "desktopSocket": "/Users/yourname/Library/Application Support/AgentDesk/bridge/state/desktop.sock",
  "git": "/usr/bin/git",
  "workspaces": {
    "mac": {
      "root": "/Users/yourname/AgentDeskWorkspace",
      "desktop": true,
      "write": true,
      "commands": {
        "git-status": [
          "/usr/bin/git",
          "status",
          "--short"
        ]
      },
      "agentCommands": [
        "git-status"
      ]
    }
  },
  "mountHome": true,
  "ssh": {
    "host": "orchestrator.example.invalid",
    "port": 22,
    "user": "agentdesk",
    "key": "/Users/yourname/.agentdesk/mac_bridge_ed25519",
    "knownHosts": "/Users/yourname/.ssh/known_hosts",
    "jump": {
      "mode": "auto",
      "host": "relay.example.invalid",
      "port": 22,
      "user": "agentdesk-jump",
      "key": "/Users/yourname/.agentdesk/jump_ed25519",
      "knownHosts": "/Users/yourname/.agentdesk/jump_known_hosts",
      "probeMinutes": 10
    }
  },
  "relay": {
    "host": "relay.example.invalid",
    "port": 22022,
    "deviceId": "mac-bridge",
    "tokenFile": "/Users/yourname/.agentdesk/relay-mac.token",
    "caFile": "/Users/yourname/.agentdesk/relay-ca.pem"
  },
  "writeAnyFolder": true
}
