[Unit]
Description=AgentDesk WeChat office assistant (personal WeChat ClawBot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agentdesk
Group=agentdesk
ExecStart=/opt/agentdesk-orchestrator/node /opt/agentdesk-orchestrator/wechat/service.js /etc/agentdesk-orchestrator/wechat.json /etc/agentdesk-orchestrator/config.json
# 办公工具链在 /opt/agentdesk-office；CLI 在 /usr/local/bin、/usr/bin。
Environment=PATH=/opt/agentdesk-office/bin:/opt/agentdesk-office/venv/bin:/opt/agentdesk-orchestrator:/usr/local/bin:/usr/bin:/bin
Environment=LANG=C.UTF-8
Environment=TZ=Asia/Shanghai
WorkingDirectory=/var/lib/agentdesk-orchestrator
# 与主控共用状态目录（CLI 登录在 homes/<cli>），本服务只写 wechat/ 子目录。
StateDirectory=agentdesk-orchestrator
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
# 凭据错时不要高频重连（会被企业微信限流）
RestartSec=60
KillMode=control-group
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryHigh=1500M
MemoryMax=1800M
TasksMax=128
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
