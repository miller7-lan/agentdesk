{
  "stateDir": "C:/Users/YourName/.agentdesk/bridge-state",
  "controlSocket": "\\\\.\\pipe\\agentdesk-windows-control",
  "controlWorkspace": "project",
  "readAnyFolder": true,
  "workspaces": {
    "project": {
      "root": "D:/Projects/project",
      "desktop": true,
      "write": true,
      "isolatedCommands": {},
      "commands": {
        "git-status": [
          "git.exe",
          "status",
          "--short"
        ],
        "java-build": [
          "javac.exe",
          "Main.java"
        ],
        "python-test": [
          "python.exe",
          "-m",
          "pytest"
        ],
        "node-build": [
          "node.exe",
          "scripts/build.js"
        ],
        "maven-test": [
          "cmd.exe",
          "/d",
          "/c",
          "C:/Tools/apache-maven/bin/mvn.cmd",
          "test"
        ],
        "gradle-test": [
          "cmd.exe",
          "/d",
          "/c",
          "gradlew.bat",
          "test"
        ]
      },
      "agentCommands": [
        "git-status",
        "python-test"
      ]
    }
  },
  "mountHome": true,
  "ssh": {
    "host": "orchestrator.example.invalid",
    "port": 22,
    "user": "agentdesk",
    "key": "C:/Users/YourName/.agentdesk/bridge_ed25519",
    "knownHosts": "C:/Users/YourName/.agentdesk/bridge_known_hosts",
    "jump": {
      "mode": "auto",
      "host": "relay.example.invalid",
      "port": 22,
      "user": "agentdesk-jump",
      "key": "C:/Users/YourName/.agentdesk/jump_ed25519",
      "knownHosts": "C:/Users/YourName/.agentdesk/jump_known_hosts",
      "probeMinutes": 10
    }
  },
  "relay": {
    "host": "relay.example.invalid",
    "port": 22022,
    "deviceId": "windows-bridge",
    "tokenFile": "C:/Users/YourName/.agentdesk/relay.token",
    "caFile": "C:/Users/YourName/.agentdesk/relay-ca.pem"
  },
  "writeAnyFolder": true
}
